{
  "extends": [
    "github>kubewarden/github-actions//renovate-config/default"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Go tool versions pinned in Makefiles",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+[A-Z_]+\\s*[:?]?=\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "groupName": "kubernetes",
      "matchPackageNames": [
        "k8s.io/**",
        "!k8s.io/klog/v2",
        "!k8s.io/kube-openapi",
        "!k8s.io/utils",
        "!k8s.io/gengo/v2",
        "sigs.k8s.io/controller-runtime"
      ]
    },
    {
      "description": "Chart enforcer images (controller, agent, debugger) are set by the release process",
      "enabled": false,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "kubewarden/runtime-enforcer/**"
      ],
      "matchFileNames": [
        "charts/runtime-enforcer/values.yaml"
      ]
    },
    {
      "description": "OpenTelemetry collector image is updated by updatecli",
      "enabled": false,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "otel/opentelemetry-collector-contrib"
      ],
      "matchFileNames": [
        "test/e2e/manifests/otel-collector.yaml"
      ]
    }
  ]
}
